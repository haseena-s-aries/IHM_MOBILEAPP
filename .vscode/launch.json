{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AURAS Web - Chrome Profile",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "profile",
      "toolArgs": [
        "--web-browser-flag=--disable-extensions",
        "--web-browser-flag=--disable-background-networking"
      ]
    },
    {
      "name": "AURAS Web - Server No Debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "flutterMode": "debug",
      "toolArgs": [
        "--web-hostname=127.0.0.1",
        "--web-port=5858"
      ]
    },
    {
      "name": "Pixel 5 - Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554"
    },
    {
      "name": "AURAS Profile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "AURAS Release",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
